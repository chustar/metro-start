{
  "name": "metro-start",
  "description": "A cross-browser new tab page inspired by Zune",
  "homepage": "http://www.metro-start.com/",
  "version": "10.10.1",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "webpack --env target=chrome",
    "build:chrome": "webpack --env target=chrome",
    "build:firefox": "webpack --env target=firefox",
    "build:xcode": "webpack --env target=xcode",
    "build:all": "webpack --env target=all",
    "lint": "eslint es6 scripts test webpack.config.js",
    "test": "bun test",
    "validate:builds": "bun run scripts/validate-builds.js",
    "check": "bun run lint && bun test && bun run build:all && bun run validate:builds",
    "build:demo": "bun run build && bun run scripts/generate-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metro-start/metro-start.git"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "jss": "github:Box9/jss#29adabd",
    "metro-select": "github:chustar/metro-select#37c6c05",
    "spectrum-colorpicker": "^1.8.1",
    "throttle-debounce": "^5.0.2",
    "tinycolor2": "^1.6.0",
    "trianglify": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "sass": "^1.94.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^7.2.2",
    "zip-webpack-plugin": "^4.0.3"
  }
}
